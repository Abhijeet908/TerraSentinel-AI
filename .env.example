# TerraSentinel AI Configuration
# Meta AI / LLM Official API Configuration (Optional)
# Leave blank to run in 100% autonomous Local Analysis Mode

# Endpoint URL (Compatible with OpenAI / Meta Llama 3 endpoints or official inference APIs)
META_AI_API_ENDPOINT=https://api.together.xyz/v1/chat/completions
# Official API Key
META_AI_API_KEY=your_meta_ai_api_key_here
# Model Identifier (e.g., meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo)
META_AI_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo

# Application Settings
TERRASENTINEL_MAX_IMAGE_DIM=1600
TERRASENTINEL_DEBUG=False
